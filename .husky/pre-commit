#!/usr/bin/env sh
# 提交前做静态检查与单元测试，避免把红的改动提交上去；
# 编译与 Windows 打包放在 pre-push 和 CI（.github/workflows/ci.yml）
set -e

if ! command -v npm >/dev/null 2>&1; then
  echo '!! 未找到 npm，无法执行静态检查与单元测试。请先安装 Node.js 并 npm install。' >&2
  exit 1
fi

echo '==> [1/2] 静态检查'
npm run lint

echo '==> [2/2] 单元测试'
npm test
